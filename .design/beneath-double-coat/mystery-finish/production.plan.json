  "dialogue": [
    {
      "id": "line-0",
      "speaker": "bruno",
      "text": "You still keep my brother's collar."
    },
    {
      "id": "line-1",
      "speaker": "heidi",
      "text": "Someone should remember Sebastian."
    },
    {
      "id": "line-2",
      "speaker": "heidi",
      "text": "That scent."
    },
    {
      "id": "line-3",
      "speaker": "heidi",
      "text": "Sebastian?"
    },
    {
      "id": "line-4",
      "speaker": "heidi",
      "text": "Who locked the door?"
    },
    {
      "id": "line-5",
      "speaker": "heidi",
      "text": "And turned off the air?"
    },
    {
      "id": "line-6",
      "speaker": "heidi",
      "text": "You monster!"
    },
    {
      "id": "line-7",
      "speaker": "bruno",
      "text": "Otto got the door."
    },
    {
      "id": "line-8",
      "speaker": "bruno",
      "text": "Grandmother, what happened?"
    },
    {
      "id": "line-9",
      "speaker": "bruno",
      "text": "He is."
    },
    {
      "id": "line-10",
      "speaker": "heidi",
      "text": "Someone locked me in."
    },
    {
      "id": "line-11",
      "speaker": "heidi",
      "text": "After I found this."
    },
    {
      "id": "line-12",
      "speaker": "heidi",
      "text": "Sebastian's fur."
    },
    {
      "id": "line-13",
      "speaker": "sadie",
      "text": "Your brother?"
    },
    {
      "id": "line-14",
      "speaker": "sadie",
      "text": "You said he was dead."
    }
  ],
