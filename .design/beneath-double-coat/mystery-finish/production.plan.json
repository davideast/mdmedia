  "facts": [
    {
      "id": "family",
      "description": "Heidi is grandmother, Bruno and Sadie married; family breakfast finished."
    },
    {
      "id": "hall",
      "description": "The adjacent hall contains a memorial collar and photograph; prints lead to grooming room."
    },
    {
      "id": "brother",
      "description": "The collar belonged to Bruno's absent brother."
    },
    {
      "id": "sebastian",
      "description": "His brother is named Sebastian."
    },
    {
      "id": "prints",
      "description": "Fresh muddy prints lead into the adjacent grooming room."
    },
    {
      "id": "groom",
      "description": "Heidi is beside fur on low grooming platform, with vent and open door established."
    },
    {
      "id": "recognition",
      "description": "Heidi recognizes Sebastian's scent."
    },
    {
      "id": "trapped",
      "description": "Heidi hears the door close and ventilation stop; she calls out."
    },
    {
      "id": "rescue",
      "description": "Same room, door now open, Bruno and Sadie have arrived."
    },
    {
      "id": "otto-helped",
      "description": "Otto got the door open offscreen."
    },
    {
      "id": "fur",
      "description": "Heidi identifies the fur as Sebastian's."
    },
    {
      "id": "dead",
      "description": "Bruno claims his brother is dead."
    },
    {
      "id": "outside",
      "description": "Nearby snowy toolshed has a view of estate windows."
    },
    {
      "id": "lookalike",
      "description": "A silent brown-collared dog resembling Bruno watches from the shed."
    },
    {
      "id": "contradiction",
      "description": "Navy-collared Bruno is still inside; two similar dogs occupy separate places."
    },
    {
      "id": "end",
      "description": "End title."
    }
