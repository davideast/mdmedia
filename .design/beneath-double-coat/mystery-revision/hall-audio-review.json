{"sources": [{id: "revision-hall-bruno-a",utterances: [{start: 0,end: 1,text: "Grandmother,",voice: "male"},{start: 1,end: 3,text: "come back in.",voice: "male"},{start: 3,end: 5,text: "Penny's negotiating for your breakfast.",voice: "male"},{start: 5,end: 7,text: "My twin got the looks, I got the sausage.",voice: "male"}],otherSounds: [{start: 7,end: 8,type: "laughter"}],uncertainWords: []},{id: "revision-hall-heidi-a",utterances: [{start: 0,end: 3,text: "Your brother Sebastian did that too.",voice: "female"},{start: 3,end: 6,text: "He'd steal breakfast without leaving his bed.",voice: "female"},{start: 7,end: 9,text: "You were supposed to share it.",voice: "female"}],otherSounds: [{start: 6,end: 7,type: "laughter"}],uncertainWords: []},{id: "revision-hall-bruno-b",utterances: [{start: 0,end: 1,text: "We did.",voice: "male"},{start: 2,end: 3,text: "Then the kennel burned down.",voice: "male"},{start: 5,end: 6,text: "He's dead, grandmother.",voice: "male"},{start: 7,end: 9,text: "You can't spend every morning waiting.",voice: "male"}],otherSounds: [],uncertainWords: []},{id: "revision-hall-heidi-b",utterances: [{start: 0,end: 2,text: "They never found him.",voice: "female"},{start: 3,end: 5,text: "You're allowed to miss him, Bruno.",voice: "female"},{start: 7,end: 9,text: "Wait, that smell.",voice: "female"}],otherSounds: [{start: 5,end: 7,type: "dog bark"}],uncertainWords: []},{id: "revision-hall-bruno-c",utterances: [{start: 0,end: 1,text: "I do.",voice: "male"},{start: 1,end: 4,text: "That's why I can't keep looking at that,",voice: "male"},{start: 4,end: 6,text: "that looking at that.",voice: "male"}],otherSounds: [{start: 0,end: 1,type: "dog bark"}],uncertainWords: []},{id: "revision-hall-heidi-c",utterances: [{start: 0,end: 2,text: "From the grooming room.",voice: "female"}],otherSounds: [],uncertainWords: []}]}