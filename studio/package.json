    "create-pyric": "file:.pyric-local/create-pyric-0.1.0-alpha.23.tgz",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pyric": "file:.pyric-local/pyric-0.1.0-alpha.23.tgz",
    "pyric-admin": "file:.pyric-local/pyric-admin-0.1.0-alpha.23.tgz",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
