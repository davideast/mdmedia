    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "mdmedia": "file:../mdmedia-0.1.0.tgz",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.13.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@pyric/cli": "file:.pyric-local/pyric-cli-0.1.0-alpha.23.tgz",
