rules_version = '2';
service cloud.firestore {
  function isAuthenticated() {
    return request.auth != null;
  }
  function isOwner(userId) {
    return isAuthenticated() && request.auth.uid == userId;
  }
  function hasClaim(claim) {
    return request.auth != null && request.auth.token[claim] != null;
  }
  function hasRequired(fields) {
    return request.resource.data.keys().hasAll(fields);
  }
  function validString(field, min, max) {
    return request.resource.data[field] is string && request.resource.data[field].size() >= min && request.resource.data[field].size() <= max;
  }
  function isOneOf(field, values) {
    return request.resource.data[field] in values;
  }
  function immutableFields(fields) {
    return request.resource.data.diff(resource.data).unchangedKeys().hasAll(fields);
  }
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return isAuthenticated() && hasClaim('email') && request.auth.token['email'] is string && hasClaim('email_verified') && request.auth.token['email_verified'] == true;
    }
    function isAllowlisted() {
      return hasVerifiedEmail() && exists(/databases/$(database)/documents/allowlist/$(request.auth.token['email'].lower()));
    }
    function canReadNarration() {
      return resource.data.visibility == 'public' && safeVoiceMetadata() || isAllowlisted() && (isOwner(resource.data.ownerUid) || resource.data.visibility == 'shared' && request.auth.uid in resource.data.sharedWith && safeVoiceMetadata());
    }
    function safeVoiceMetadata() {
      return resource.data.get('voiceProvider', 'gemini') != 'elevenlabs' || !resource.data.keys().hasAny(['voiceId']);
    }
    function validNarrationFields() {
      return validString('title', 1, 200) && isOneOf('visibility', ['private', 'shared', 'public']) && isOneOf('status', ['streaming', 'ready', 'error']) && request.resource.data.ownerUid is string && request.resource.data.sharedWith is list && request.resource.data.sharedWith.size() <= 50 && request.resource.data.get('sharedWithLabels', {}) is map && request.resource.data.get('sharedWithLabels', {}).size() <= 50 && request.resource.data.createdAt is number && request.resource.data.updatedAt is number;
    }
    function validPlaylistFields() {
      return validString('title', 1, 200) && request.resource.data.ownerUid is string && request.resource.data.description is string && request.resource.data.narrationIds is list && request.resource.data.narrationIds.size() <= 100 && request.resource.data.createdAt is number && request.resource.data.updatedAt is number;
    }
    match /allowlist/{email} {
      allow get: if hasVerifiedEmail() && request.auth.token['email'].lower() == email;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if isOwner(uid) && isAllowlisted();
      allow create, update: if isOwner(uid) && isAllowlisted();
      allow list, delete: if false;
    }
    match /voiceCatalog/{voiceId} {
      allow read, write: if false;
    }
    match /users/{uid}/voiceGrants/{voiceId} {
      allow read, write: if false;
    }
    match /apiKeys/{keyId} {
      allow read, write: if false;
    }
    match /deviceAuthorizations/{deviceId} {
      allow read, write: if false;
    }
    match /mediaItems/{id} {
      allow read, write: if false;
    }
    match /mediaGenerations/{id} {
      allow read, write: if false;
    }
    match /mediaActivity/{id} {
      allow read, write: if false;
    }
    match /mediaAssets/{id} {
      allow read, write: if false;
    }
    match /mediaRequests/{id} {
      allow read, write: if false;
    }
    match /mediaQuotas/{id} {
      allow read, write: if false;
    }
    match /mediaCatalogMigrations/{id} {
      allow read, write: if false;
    }
    match /narrations/{narrationId} {
      allow get, list: if canReadNarration();
      allow create: if false;
      allow update: if isAllowlisted() && isOwner(resource.data.ownerUid) && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'visibility', 'sharedWith', 'updatedAt']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'visibility', 'sharedWith', 'sharedWithLabels', 'updatedAt'])) && validNarrationFields();
      allow delete: if isAllowlisted() && isOwner(resource.data.ownerUid);
    }
    match /playlists/{playlistId} {
      allow get, list: if isAllowlisted() && isOwner(resource.data.ownerUid);
      allow create: if isAllowlisted() && isOwner(request.resource.data.ownerUid) && hasRequired(['ownerUid', 'title', 'description', 'narrationIds', 'createdAt', 'updatedAt']) && validPlaylistFields();
      allow update: if isAllowlisted() && isOwner(resource.data.ownerUid) && immutableFields(['ownerUid', 'createdAt']) && validPlaylistFields();
      allow delete: if isAllowlisted() && isOwner(resource.data.ownerUid);
    }
  }
}
