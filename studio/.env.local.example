# Firebase web configuration. Safe to expose: these identify the project, they
# do not grant access — Security Rules do that.

# Web API key from the Firebase console, Project settings, Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Domain that hosts the Google sign-in flow, usually <project-id>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# The Firebase / Google Cloud project id.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Cloud Storage bucket holding narration audio and word timings.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Sender id issued with the project; required by the web SDK config.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web app id for this specific app registration.
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side configuration. Never prefixed with NEXT_PUBLIC_.

# Project the Admin SDK talks to; defaults to the public project id when unset.
FIREBASE_PROJECT_ID=
# Bucket the Admin SDK writes audio to; defaults to the public bucket when unset.
FIREBASE_STORAGE_BUCKET=
# Absolute path to a service account key file. Leave empty on a platform that
# supplies its own default credential.
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini API key used by the server-side narration synthesis route.
GEMINI_API_KEY=
# ElevenLabs key for voice search and synthesis. Requires voices_read and text_to_speech.
ELEVENLABS_API_KEY=

# Public Studio origin for API approval, narration, and audio links behind a proxy.
# MDMEDIA_PUBLIC_ORIGIN=https://<device>.<tailnet>.ts.net:3443

# Development networking (optional). Use different public and internal ports
# with Windows Tailscale and mirrored WSL networking; see README.md.
# PORT=3001
# MDMEDIA_PYRIC_PORT=3474
# NEXT_PUBLIC_PYRIC_BRIDGE_PORT=3444
# MDMEDIA_ALLOWED_DEV_ORIGINS=<device>.<tailnet>.ts.net
