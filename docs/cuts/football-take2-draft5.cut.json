  "lines": [
    {
      "id": "c_open",
      "speaker": "Chet",
      "text": "Good afternoon, everybody, and welcome to CGL Football! Moose, what are your keys to the game?",
      "src": "take:fb2-c-open-t5",
      "in": 0.5,
      "out": 5.95,
      "at": "open",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "bright, warm network welcome; the question to Moose ordinary and friendly"
    },
    {
      "id": "m_k1",
      "speaker": "Moose",
      "text": "Key number one: score more points than the other team.",
      "src": "take:fb2-m-k1-t5",
      "in": 1.1,
      "out": 4.4,
      "at": "c_open+5.55",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "steady, matter-of-fact and sincere, as if it were real inside knowledge"
    },
    {
      "id": "m_k2",
      "speaker": "Moose",
      "text": "Key number two: don't let the other team score more points than you.",
      "src": "take:fb2-m-k2-t7",
      "in": 1.05,
      "out": 5.15,
      "at": "m_k1+3.33",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "the same steady, sincere delivery as key one"
    },
    {
      "id": "m_k3",
      "speaker": "Moose",
      "text": "Key number three: don't tackle your own guys.",
      "src": "take:fb2-m-k3-t5",
      "in": 0.8,
      "out": 3.85,
      "at": "m_k2+4.27",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "the same steady, sincere delivery as keys one and two"
    },
    {
      "id": "c_echo",
      "speaker": "Chet",
      "text": "...Don't tackle your own guys?",
      "src": "take:fb2-c-echo-t8",
      "in": 0.45,
      "out": 2.3,
      "at": "echo",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "a little doubtful, quiet, a real question; never mocking"
    },
    {
      "id": "m_effective",
      "speaker": "Moose",
      "text": "Yeah, Chet. I've seen it, and it is not effective.",
      "src": "take:vs-moose2-t3",
      "in": 1,
      "out": 4.6,
      "at": "eff",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "low, steady and completely serious"
    },
    {
      "id": "c_td",
      "speaker": "Chet",
      "text": "Touchdown, Icebreakers! That's key number one, Moose!",
      "src": "take:fb2-c-td-t9",
      "in": 0.4,
      "out": 3.95,
      "at": "icetd+0.67",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "an excited touchdown call, then pleased, to Moose"
    },
    {
      "id": "m_scoring",
      "speaker": "Moose",
      "text": "Exactly, Chet. They're scoring more points than the other team.",
      "src": "take:fb2-m-scoring-t4",
      "in": 1,
      "out": 4.55,
      "at": "c_td+3.6",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "approving, deadpan"
    },
    {
      "id": "m_letting",
      "speaker": "Moose",
      "text": "See, now they're letting the other team score more points than them.",
      "src": "take:fb2-m-letting-t1",
      "in": 1.1,
      "out": 4.2,
      "at": "tartd+0.5",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "a little disappointed, deadpan"
    },
    {
      "id": "c_clock",
      "speaker": "Chet",
      "text": "Forty-one seconds left, Tarpons ball. They just have to run out the clock.",
      "src": "take:fb2-c-clock-t4",
      "in": 0.75,
      "out": 4.6,
      "at": "m_letting+3.15",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "measured and a little tense"
    },
    {
      "id": "c_play",
      "speaker": "Chet",
      "text": "Handoff... oh! He's run over by his own man! It's loose! Icebreakers have it... touchdown!",
      "src": "take:fb2-c-play-t8",
      "in": 0.5,
      "out": 7.15,
      "at": "handoff+0.19",
      "volume": 1.25,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "live play-by-play that builds to the touchdown, excited, never a scream"
    },
    {
      "id": "c_kick",
      "speaker": "Chet",
      "text": "The kick is good!",
      "src": "take:fb2-c-kick-t9",
      "in": 0.45,
      "out": 1.5,
      "at": "kick+0.84",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "a bright, quick call"
    },
    {
      "id": "c_close",
      "speaker": "Chet",
      "text": "What a thrilling come-from-behind win by the Icebreakers! Moose, what do you think sparked that comeback?",
      "src": "take:vs-chet-t1",
      "in": 0.55,
      "out": 7,
      "at": "close",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "thrilled but polished; the question ordinary and friendly"
    },
    {
      "id": "m_close",
      "speaker": "Moose",
      "text": "They didn't tackle their own guys, Chet... they didn't tackle their own guys.",
      "src": "take:fb2-m-close-t3",
      "in": 0.85,
      "out": 6.14,
      "at": "mclose",
      "volume": 1.5,
      "fadeIn": 0.04,
      "fadeOut": 0.08,
      "delivery": "slow and sincere, a thoughtful pause, then the repeat softer, almost reverent"
    }
  ],
