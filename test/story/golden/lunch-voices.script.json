      "delivery": "a smart, sarcastic thirteen-year-old girl, dry and warm"
    },
    "HARPER": {
      "id": "HARPER",
      "voice": "Zephyr",
      "delivery": "a bubbly, confident eighth-grade girl, student council president"
    },
