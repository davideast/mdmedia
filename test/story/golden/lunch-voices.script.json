  "chapters": [
    {
      "id": "00",
      "index": 0,
      "title": "The Most Embarrassing Day of My Life — Lunch",
      "scenes": [
        {
          "id": "00/00",
          "index": 0,
          "segments": [
            {
              "kind": "line",
              "id": "00/00/0001-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "warm, smug, building up the good news",
              "text": "By lunch, things were going better than I'd imagined.",
              "display": "By lunch, things were going better than I'd imagined.",
              "source": {
                "line": 27,
                "column": 1,
                "endLine": 27,
                "endColumn": 106
              }
            },
            {
              "kind": "line",
              "id": "00/00/0002-harper",
              "speaker": "HARPER",
              "narration": false,
              "cue": "loud and delighted, calling across the cafeteria",
              "text": "Milo! Dude!",
              "display": "Milo! Dude!",
              "source": {
                "line": 29,
                "column": 1,
                "endLine": 29,
                "endColumn": 77
              }
            },
            {
              "kind": "line",
              "id": "00/00/0003-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "giddy, can't believe it",
              "text": "An actual high five.",
              "display": "An actual high five.",
              "source": {
                "line": 31,
                "column": 1,
                "endLine": 31,
                "endColumn": 59
              }
            },
            {
              "kind": "line",
              "id": "00/00/0004-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "even more giddy, savoring the name",
              "text": "From Harper Blake.",
              "display": "From Harper Blake.",
              "source": {
                "line": 33,
                "column": 1,
                "endLine": 33,
                "endColumn": 68
              }
            },
            {
              "kind": "line",
              "id": "00/00/0005-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "proud, a little smug",
              "text": "At our lunch table.",
              "display": "At our lunch table.",
              "source": {
                "line": 35,
                "column": 1,
                "endLine": 35,
                "endColumn": 55
              }
            },
            {
              "kind": "line",
              "id": "00/00/0006-harper",
              "speaker": "HARPER",
              "narration": false,
              "cue": "warm, flattering",
              "text": "You're definitely one of my favorites.",
              "display": "You're definitely one of my favorites.",
              "source": {
                "line": 37,
                "column": 1,
                "endLine": 37,
                "endColumn": 72
              }
            },
            {
              "kind": "line",
              "id": "00/00/0007-harper",
              "speaker": "HARPER",
              "narration": false,
              "cue": "gushing, excited",
              "text": "That clip? Hilarious. We're using it in the assembly.",
              "display": "That clip? Hilarious. We're using it in the assembly.",
              "source": {
                "line": 39,
                "column": 1,
                "endLine": 39,
                "endColumn": 87
              }
            },
            {
              "kind": "line",
              "id": "00/00/0008-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "the fun drains out, sudden dread",
              "text": "My smile froze.",
              "display": "My smile froze.",
              "source": {
                "line": 41,
                "column": 1,
                "endLine": 41,
                "endColumn": 63
              }
            },
            {
              "kind": "line",
              "id": "00/00/0009-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "uneasy, trying to sound casual",
              "text": "Wait. Using it?",
              "display": "Wait. Using it?",
              "source": {
                "line": 43,
                "column": 1,
                "endLine": 43,
                "endColumn": 61
              }
            },
            {
              "kind": "line",
              "id": "00/00/0010-harper",
              "speaker": "HARPER",
              "narration": false,
              "cue": "breezy, already leaving",
              "text": "Yeah! Right before we announce the new host. It's going to kill!",
              "display": "Yeah! Right before we announce the new host. It's going to kill!",
              "source": {
                "line": 45,
                "column": 1,
                "endLine": 45,
                "endColumn": 105
              }
            },
            {
              "kind": "line",
              "id": "00/00/0011-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "flat, quietly suspicious",
              "text": "What clip?",
              "display": "What clip?",
              "source": {
                "line": 47,
                "column": 1,
                "endLine": 47,
                "endColumn": 50
              }
            },
            {
              "kind": "line",
              "id": "00/00/0012-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "guilty, avoiding",
              "text": "I stared at my tray.",
              "display": "I stared at my tray.",
              "source": {
                "line": 49,
                "column": 1,
                "endLine": 49,
                "endColumn": 52
              }
            },
            {
              "kind": "line",
              "id": "00/00/0013-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "firmer, waiting for an answer",
              "text": "Milo?",
              "display": "Milo?",
              "source": {
                "line": 51,
                "column": 1,
                "endLine": 51,
                "endColumn": 50
              }
            },
            {
              "kind": "line",
              "id": "00/00/0014-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "embarrassed, self-mocking",
              "text": "I tried to laugh. It sounded like a lawn mower failing to start.",
              "display": "I tried to laugh. It sounded like a lawn mower failing to start.",
              "source": {
                "line": 53,
                "column": 1,
                "endLine": 53,
                "endColumn": 105
              }
            },
            {
              "kind": "line",
              "id": "00/00/0015-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "weak, nervous laugh",
              "text": "Heh. Okay. Funny story.",
              "display": "Heh. Okay. Funny story.",
              "source": {
                "line": 55,
                "column": 1,
                "endLine": 55,
                "endColumn": 58
              }
            },
            {
              "kind": "line",
              "id": "00/00/0016-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "cold, slow, each word its own sentence",
              "text": "What. Clip.",
              "display": "What. Clip.",
              "source": {
                "line": 57,
                "column": 1,
                "endLine": 57,
                "endColumn": 65
              }
            },
            {
              "kind": "line",
              "id": "00/00/0017-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "barely audible, ashamed",
              "text": "The dancing one.",
              "display": "The dancing one.",
              "source": {
                "line": 59,
                "column": 1,
                "endLine": 59,
                "endColumn": 55
              }
            },
            {
              "kind": "line",
              "id": "00/00/0018-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "hopeful, then unsure",
              "text": "For one second, I thought she'd laugh.",
              "display": "For one second, I thought she'd laugh.",
              "source": {
                "line": 61,
                "column": 1,
                "endLine": 61,
                "endColumn": 74
              }
            },
            {
              "kind": "line",
              "id": "00/00/0019-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "quiet, careful",
              "text": "Not angry.",
              "display": "Not angry.",
              "source": {
                "line": 63,
                "column": 1,
                "endLine": 63,
                "endColumn": 40
              }
            },
            {
              "kind": "line",
              "id": "00/00/0020-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "heavy, quiet",
              "text": "Worse. Hurt.",
              "display": "Worse. Hurt.",
              "source": {
                "line": 65,
                "column": 1,
                "endLine": 65,
                "endColumn": 40
              }
            },
            {
              "kind": "line",
              "id": "00/00/0021-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "stunned, disbelieving",
              "text": "You sent my video?",
              "display": "You sent my video?",
              "source": {
                "line": 67,
                "column": 1,
                "endLine": 67,
                "endColumn": 55
              }
            },
            {
              "kind": "line",
              "id": "00/00/0022-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "defensive, too fast",
              "text": "It was just to Harper.",
              "display": "It was just to Harper.",
              "source": {
                "line": 69,
                "column": 1,
                "endLine": 69,
                "endColumn": 57
              }
            },
            {
              "kind": "line",
              "id": "00/00/0023-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "hurt, quiet",
              "text": "You promised.",
              "display": "You promised.",
              "source": {
                "line": 71,
                "column": 1,
                "endLine": 71,
                "endColumn": 40
              }
            },
            {
              "kind": "line",
              "id": "00/00/0024-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "pleading",
              "text": "I know, but—",
              "display": "I know, but—",
              "source": {
                "line": 73,
                "column": 1,
                "endLine": 73,
                "endColumn": 36
              }
            },
            {
              "kind": "line",
              "id": "00/00/0025-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "hurt, voice catching",
              "text": "You promised, Milo.",
              "display": "You promised, Milo.",
              "source": {
                "line": 75,
                "column": 1,
                "endLine": 75,
                "endColumn": 55
              }
            },
            {
              "kind": "line",
              "id": "00/00/0026-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "numb, distant",
              "text": "Around us, the cafeteria continued its usual chaos.",
              "display": "Around us, the cafeteria continued its usual chaos.",
              "source": {
                "line": 77,
                "column": 1,
                "endLine": 77,
                "endColumn": 80
              }
            },
            {
              "kind": "line",
              "id": "00/00/0027-kid",
              "speaker": "KID",
              "narration": false,
              "cue": "loud, indignant, far away",
              "text": "Ketchup is TOO a vegetable!",
              "display": "Ketchup is TOO a vegetable!",
              "source": {
                "line": 79,
                "column": 1,
                "endLine": 79,
                "endColumn": 67
              }
            },
            {
              "kind": "line",
              "id": "00/00/0028-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "hushed, heavy",
              "text": "But at our table, everything had gone quiet.",
              "display": "But at our table, everything had gone quiet.",
              "source": {
                "line": 81,
                "column": 1,
                "endLine": 81,
                "endColumn": 73
              }
            },
            {
              "kind": "line",
              "id": "00/00/0029-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "ashamed, small",
              "text": "I thought it might help me win.",
              "display": "I thought it might help me win.",
              "source": {
                "line": 83,
                "column": 1,
                "endLine": 83,
                "endColumn": 61
              }
            },
            {
              "kind": "line",
              "id": "00/00/0030-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "pleading, desperate",
              "text": "June, come on.",
              "display": "June, come on.",
              "source": {
                "line": 85,
                "column": 1,
                "endLine": 85,
                "endColumn": 49
              }
            },
            {
              "kind": "line",
              "id": "00/00/0031-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "quiet, steady, hurt",
              "text": "You know why I sent you that video?",
              "display": "You know why I sent you that video?",
              "source": {
                "line": 87,
                "column": 1,
                "endLine": 87,
                "endColumn": 70
              }
            },
            {
              "kind": "line",
              "id": "00/00/0032-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "unsure, guessing",
              "text": "To see if the dance was good.",
              "display": "To see if the dance was good.",
              "source": {
                "line": 89,
                "column": 1,
                "endLine": 89,
                "endColumn": 61
              }
            },
            {
              "kind": "line",
              "id": "00/00/0033-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "soft, sad",
              "text": "No.",
              "display": "No.",
              "source": {
                "line": 91,
                "column": 1,
                "endLine": 91,
                "endColumn": 28
              }
            },
            {
              "kind": "line",
              "id": "00/00/0034-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "voice shaking, holding back tears",
              "text": "Because I was scared. And you always make scary things feel less scary.",
              "display": "Because I was scared. And you always make scary things feel less scary.",
              "source": {
                "line": 93,
                "column": 1,
                "endLine": 93,
                "endColumn": 120
              }
            },
            {
              "kind": "line",
              "id": "00/00/0035-june",
              "speaker": "JUNE",
              "narration": false,
              "cue": "barely holding it together, almost a whisper",
              "text": "I guess that was stupid.",
              "display": "I guess that was stupid.",
              "source": {
                "line": 95,
                "column": 1,
                "endLine": 95,
                "endColumn": 84
              }
            },
            {
              "kind": "line",
              "id": "00/00/0036-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "hollow, alone",
              "text": "I sat there holding a french fry.",
              "display": "I sat there holding a french fry.",
              "source": {
                "line": 97,
                "column": 1,
                "endLine": 97,
                "endColumn": 62
              }
            },
            {
              "kind": "line",
              "id": "00/00/0037-milo",
              "speaker": "MILO",
              "narration": false,
              "cue": "rueful, sad but wry",
              "text": "It was probably the worst french fry of my entire life.",
              "display": "It was probably the worst french fry of my entire life.",
              "source": {
                "line": 99,
                "column": 1,
                "endLine": 99,
                "endColumn": 90
              }
            }
          ]
        }
      ]
    }
  ]
}
