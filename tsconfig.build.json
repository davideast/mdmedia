{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/verify-package.ts",
    "src/verify-port.ts",
    "src/tui/**/*",
    "src/studio/**/*",
    "src/sidecar/**/*",
    "src/cli/agy-watch.ts",
    "src/cli/plugin-installer.ts",
    "src/cli/listen-parser.ts"
  ]
}
