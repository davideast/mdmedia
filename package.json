{
  "name": "mdmedia",
  "version": "0.1.0",
  "description": "Convert markdown documents into rich audio and video media via Gemini Flash 3.1 TTS and Gemini Omni Flash",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    },
    "./chunker": {
      "types": "./dist/chunker/index.d.ts",
      "import": "./dist/chunker/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./tts": {
      "types": "./dist/tts/index.d.ts",
      "import": "./dist/tts/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./narration": {
      "types": "./dist/narration/index.d.ts",
      "import": "./dist/narration/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "bin": {
    "mdmedia": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "verify-package": "bun run src/verify-package.ts",
    "dev": "bun run src/bin.ts",
    "start": "bun run src/bin.ts",
    "test": "bun test",
    "verify": "bun run src/verify-port.ts && bun run verify-package",
    "watch": "bun run src/cli/agy-watch.ts",
    "agy-watch": "bun run src/cli/agy-watch.ts",
    "studio": "bun run src/bin.ts studio"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "citty": "^0.2.2",
    "marked": "^18.0.9",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  }
}
