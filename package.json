{
  "name": "mdmedia",
  "version": "0.1.0",
  "description": "Convert markdown into audio with Gemini or ElevenLabs, plus Gemini video, Lyria music, and ElevenLabs sound effects",
  "license": "MIT",
  "author": "David East",
  "repository": {
    "type": "git",
    "url": "https://github.com/davideast/mdmedia"
  },
  "homepage": "https://github.com/davideast/mdmedia",
  "keywords": [
    "markdown",
    "audio",
    "tts",
    "text-to-speech",
    "gemini",
    "elevenlabs",
    "video",
    "music",
    "sound-effects",
    "narration",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    },
    "./music": {
      "types": "./dist/music/index.d.ts",
      "import": "./dist/music/index.js"
    },
    "./sfx": {
      "types": "./dist/sfx/index.d.ts",
      "import": "./dist/sfx/index.js"
    },
    "./chunker": {
      "types": "./dist/chunker/index.d.ts",
      "import": "./dist/chunker/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./tts": {
      "types": "./dist/tts/index.d.ts",
      "import": "./dist/tts/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./narration": {
      "types": "./dist/narration/index.d.ts",
      "import": "./dist/narration/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "bin": {
    "mdmedia": "./dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "prepublishOnly": "bun test && bun run verify",
    "verify-package": "bun run src/verify-package.ts",
    "dev": "bun run src/bin.ts",
    "start": "bun run src/bin.ts",
    "test": "bun test",
    "test:proofs": "bun test test/regression/",
    "test:oracles": "VERIFY_ORACLE=1 bun test test/regression/",
    "verify": "bun run src/verify-port.ts && bun run verify-package",
    "studio:dev": "npm --prefix studio run dev",
    "studio:bg": "npm --prefix studio run dev:bg",
    "studio:stop": "npm --prefix studio run dev:stop",
    "studio:status": "npm --prefix studio run dev:status",
    "studio:logs": "npm --prefix studio run dev:logs",
    "studio:allowlist": "npm --prefix studio run allowlist --"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "citty": "^0.2.2",
    "marked": "^18.0.9"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "@types/bun": "^1.2.4",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.47.0",
    "marked-alert": "^2.1.2",
    "mdmedia": "link:.",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-resizable-panels": "^4.13.1",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3"
  }
}
