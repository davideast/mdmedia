# Prevent secrets, local Firebase/Pyric state, and node_modules from entering
# the Cloud Build / Docker build context (`gcloud run deploy --source .`).

.git
.gitignore
**/node_modules
**/.next
dist
**/.env*
**/*service-account*.json
**/*credentials*.json
studio/.pyric
studio/.pyric-local
studio/.dev.pid
studio/.dev.log
studio/vendor
functions/node_modules
functions/lib
*.wav
*.tgz
